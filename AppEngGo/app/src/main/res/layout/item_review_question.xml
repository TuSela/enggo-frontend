<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_pvp_setting_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_order"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_gray"
            android:gravity="center"
            android:text="1"
            android:textColor="#212121"
            android:fontFamily="@font/nunito_black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="ĐÚNG"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/nunito_black"
            android:background="@drawable/bg_badge_green" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+2.0"
            android:textColor="#9E9E9E"
            android:fontFamily="@font/nunito_black"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_question_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Question content here..."
        android:textColor="#212121"
        android:fontFamily="@font/nunito_bold"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/container_review_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/layout_explanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#F9F9F9"
        android:padding="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giải thích:"
            android:textColor="#FF8C00"
            android:fontFamily="@font/nunito_black"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Explanation text..."
            android:textColor="#616161"
            android:fontFamily="@font/nunito_bold"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>