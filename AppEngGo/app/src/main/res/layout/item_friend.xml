<?xml version="1.0" encoding="utf-8"?>
<!-- Item hàng bạn bè trong phần TẤT CẢ BẠN BÈ -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp">

        <!-- Avatar + chấm online -->
        <FrameLayout
            android:id="@+id/fl_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_default_avatar"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_circle" />

            <!-- Chấm xanh online -->
            <View
                android:id="@+id/dot_online"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_dot_online"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Username -->
        <TextView
            android:id="@+id/tv_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/fl_avatar"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:text="Phương Linh"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <!-- Nút chat -->
        <ImageView
            android:id="@+id/btn_chat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_chat_bubble"
            android:background="@drawable/bg_btn_chat"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>