<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_pvp_setting_card"
    android:padding="16dp">

    <!-- KHUNG CHỨA THỨ HẠNG -->
    <FrameLayout
        android:id="@+id/layout_rank_container"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_centerVertical="true">

        <ImageView
            android:id="@+id/iv_rank_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_toprank"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_rank_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- AVATAR -->
    <ImageView
        android:id="@+id/iv_rank_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@id/layout_rank_container"
        android:src="@drawable/ic_default_avatar" />

    <!-- THÔNG TIN USER -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@id/iv_rank_avatar"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_rank_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên người dùng"
            android:textColor="#4B4B4B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_badge_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_rank" />

            <TextView
                android:id="@+id/tv_rank_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danh hiệu"
                android:textColor="#AFAFAF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ĐIỂM SỐ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_rank_elo_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#4B4B4B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Points"
            android:textColor="#AFAFAF"
            android:textSize="10sp" />
    </LinearLayout>
</RelativeLayout>