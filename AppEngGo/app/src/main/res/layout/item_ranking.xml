<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_pvp_setting_card"
    android:padding="16dp">

    <!-- KHU VỰC THỨ HẠNG (RANK) -->
    <!-- Dành riêng cho Rank 1 (Hiển thị Icon Sấm sét/Cúp) -->
    <ImageView
        android:id="@+id/iv_rank_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_bolt"
        app:tint="@color/primary_orange"
        android:visibility="gone" />

    <!-- Dành cho Rank 2, 3, 4... (Hiển thị Số) -->
    <TextView
        android:id="@+id/tv_rank_number"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/primary_blue"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="visible" />

    <!-- KHU VỰC AVATAR -->
    <ImageView
        android:id="@+id/iv_rank_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@id/tv_rank_number"
        android:src="@drawable/ic_person"
        android:background="@drawable/bg_circle"
        android:backgroundTint="#F7F7F7" />

    <!-- KHU VỰC THÔNG TIN USER (Tên & Danh hiệu) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@id/iv_rank_avatar"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_rank_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên người chơi"
            android:textColor="#4B4B4B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_rank_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bạc III"
            android:textColor="#AFAFAF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- KHU VỰC ĐIỂM SỐ (ELO/POINTS) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_rank_elo_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#4B4B4B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POINTS"
            android:textColor="#AFAFAF"
            android:textSize="10sp" />
    </LinearLayout>
</RelativeLayout>