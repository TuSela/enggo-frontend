<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow_back"
                app:tint="#B0B0B0" />

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="THÁCH ĐẤU PVP"
                android:textColor="#4B4B4B"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#F0F0F0" />

        <!-- Tab Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pvp_tab_container"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_invite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pvp_tab_selected"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="MỜI BẠN"
                android:textColor="@color/primary_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_ranking"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="XẾP HẠNG"
                android:textColor="#AFAFAF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_container"
        android:layout_above="@id/btn_start_container">

        <!-- MÀN HÌNH 1: MỜI BẠN -->
        <ScrollView
            android:id="@+id/layout_invite_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="40dp"
                android:clipChildren="false">

                <!-- VS Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clipChildren="false">

                    <!-- User Profile -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clipChildren="false">
                        <FrameLayout
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:clipChildren="false">
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_circle_border_blue" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginBottom="-14dp"
                                android:background="@drawable/bg_pvp_lv_badge"
                                android:paddingHorizontal="18dp"
                                android:paddingVertical="4dp"
                                android:text="LV 15"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:elevation="4dp"/>
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:text="Tuandb"
                            android:textColor="#4B4B4B"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- VS Badge -->
                    <TextView
                        android:id="@+id/vs_icon"
                        android:layout_width="60dp"
                        android:layout_height="66dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_pvp_vs"
                        android:gravity="center"
                        android:paddingBottom="10dp"
                        android:text="vs"
                        android:textColor="@color/white"
                        android:textSize="36sp"
                        android:textStyle="bold|italic" />

                    <!-- Enemy Placeholder -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:background="@drawable/bg_circle_dotted">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="+"
                                android:textColor="#DCDCDC"
                                android:textSize="70sp" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:text="Chờ đối thủ..."
                            android:textColor="#AFAFAF"
                            android:textSize="20sp"
                            android:textStyle="italic" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Settings Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:id="@+id/card_topic"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pvp_setting_card"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_themes"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="CHỦ ĐỀ"
                            android:textColor="#AFAFAF"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_topic_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Từ vựng"
                            android:textColor="#4B4B4B"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_difficulty"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pvp_setting_card"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/iv_difficulty_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_medium" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="ĐỘ KHÓ"
                            android:textColor="@color/primary_orange"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_difficulty_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vừa"
                            android:textColor="#4B4B4B"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_question_count"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pvp_setting_card"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_list_check" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="SỐ CÂU"
                            android:textColor="#AFAFAF"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_question_count_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 Câu"
                            android:textColor="#4B4B4B"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Friend Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bạn bè"
                        android:textColor="#4B4B4B"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="XEM TẤT CẢ"
                        android:textColor="@color/primary_blue"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Danh sách bạn bè động -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_friends_pvp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </ScrollView>

        <!-- MÀN HÌNH 2: XẾP HẠNG -->
        <ScrollView
            android:id="@+id/layout_ranking_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="20dp"
                android:clipChildren="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pvp_setting_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:clipChildren="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipChildren="false">

                        <FrameLayout
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:clipChildren="false">

                            <ImageView
                                android:id="@+id/iv_my_profile_avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_person"
                                android:background="@drawable/bg_circle_border_blue" />

                            <TextView
                                android:id="@+id/tv_my_profile_level"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginBottom="-10dp"
                                android:background="@drawable/bg_pvp_lv_badge"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="2dp"
                                android:text="LV. 0"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:elevation="4dp"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tv_my_rank_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tên của bạn"
                                android:textColor="#4B4B4B"
                                android:textSize="26sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tv_my_badge_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_light_blue"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="Chưa xếp hạng"
                                android:textColor="@color/primary_blue"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_my_rank_badge_icon"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:src="@drawable/rank4"
                            android:background="@drawable/bg_quantity_picker"
                            android:padding="1dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="RANK POINTS"
                                    android:textColor="#AFAFAF"
                                    android:textSize="12sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:id="@+id/tv_my_elo_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:text="0/100"
                                    android:textColor="#4B4B4B"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>
                            </RelativeLayout>

                            <ProgressBar
                                android:id="@+id/pb_my_rank_progress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:progress="0"
                                android:progressDrawable="@drawable/progress_bar_blue" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Ranking Title Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BẢNG XẾP HẠNG"
                        android:textColor="#4B4B4B"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Làm mới trong: 14h"
                        android:textColor="@color/primary_blue"
                        android:textSize="12sp" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_ranking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pvp_setting_card"
        android:padding="16dp">
        <ImageView
            android:id="@+id/rank_icon_1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_bolt"
            app:tint="@color/primary_orange" />
        <ImageView
            android:id="@+id/rank_avt_1"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/rank_icon_1"
            android:src="@drawable/ic_person"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/primary_orange"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/rank_avt_1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rank_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player"
                android:textColor="#4B4B4B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/rank_desc_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có xếp hạng"
                android:textColor="#AFAFAF"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rank_points_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2,450"
                android:textColor="#4B4B4B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POINTS"
                android:textColor="#AFAFAF"
                android:textSize="10sp" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pvp_setting_card"
        android:padding="16dp">
        <TextView
            android:id="@+id/rank_num_2"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/primary_blue"
            android:textSize="20sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/rank_avt_2"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/rank_num_2"
            android:src="@drawable/ic_person"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#E5E5E5"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/rank_avt_2"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rank_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player"
                android:textColor="#4B4B4B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/rank_desc_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có xếp hạng"
                android:textColor="#AFAFAF"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rank_points_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2,120"
                android:textColor="#4B4B4B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POINTS"
                android:textColor="#AFAFAF"
                android:textSize="10sp" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pvp_setting_card"
        android:padding="16dp">
        <TextView
            android:id="@+id/rank_num_3"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="3"
            android:textColor="#D35400"
            android:textSize="20sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/rank_avt_3"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/rank_num_3"
            android:src="@drawable/ic_person"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#FFECC7"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/rank_avt_3"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rank_name_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player"
                android:textColor="#4B4B4B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/rank_desc_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có xếp hạng"
                android:textColor="#AFAFAF"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rank_points_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,890"
                android:textColor="#4B4B4B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POINTS"
                android:textColor="#AFAFAF"
                android:textSize="10sp" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pvp_setting_card"
        android:padding="16dp">
        <TextView
            android:id="@+id/rank_num_4"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="4"
            android:textColor="#AFAFAF"
            android:textSize="20sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/rank_avt_4"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/rank_num_4"
            android:src="@drawable/ic_person"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#F7F7F7"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
