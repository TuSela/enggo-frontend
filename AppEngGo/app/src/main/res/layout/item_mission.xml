<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pvp_setting_card"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <!-- Text block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_mission_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nhiệm vụ"
                android:textColor="#4B4B4B"
                android:fontFamily="@font/nunito_black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_mission_exp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+50 XP"
                android:textColor="#1CB0F6"
                android:fontFamily="@font/nunito_black"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_mission_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hoàn thành 3 bài quiz"
            android:textColor="#AFAFAF"
            android:fontFamily="@font/nunito_bold"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ProgressBar
                android:id="@+id/pb_mission"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:progress="0"
                android:max="3"
                android:progressDrawable="@drawable/progress_bar_green" />

            <TextView
                android:id="@+id/tv_mission_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/3"
                android:textColor="#AFAFAF"
                android:fontFamily="@font/nunito_black"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Claim button -->
    <Button
        android:id="@+id/btn_claim"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_button_blue"
        android:text="Nhận thưởng"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/nunito_black"
        android:textSize="11sp"
        android:paddingHorizontal="10dp"
        android:visibility="gone" />

</LinearLayout>