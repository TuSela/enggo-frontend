<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="56dp"
        android:paddingBottom="32dp">

        <!-- ── Outcome banner ───────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="32dp"
            android:background="@drawable/bg_pvp_setting_card"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_outcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 CHIẾN THẮNG!"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#2979FF" />

            <TextView
                android:id="@+id/tv_outcome_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Xuất sắc! Bạn đã thắng trận này."
                android:textSize="14sp"
                android:textColor="#888888" />
        </LinearLayout>

        <!-- ── Comparison card ──────────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BẠN"
                        android:gravity="center"
                        android:textColor="#2979FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#E0E0E0" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ĐỐI THỦ"
                        android:gravity="center"
                        android:textColor="#888888"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Score row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Điểm số"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA" />

                        <TextView
                            android:id="@+id/tv_my_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="80 điểm"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VS"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#CCCCCC"
                        android:layout_gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Điểm số"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA" />

                        <TextView
                            android:id="@+id/tv_opp_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="60 điểm"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginVertical="8dp" />

                <!-- Correct count row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trả lời đúng"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA" />

                        <TextView
                            android:id="@+id/tv_my_correct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8 câu đúng"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#E0E0E0" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trả lời đúng"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA" />

                        <TextView
                            android:id="@+id/tv_opp_correct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6 câu đúng"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginVertical="8dp" />

                <!-- ELO row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thay đổi ELO"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA" />

                        <TextView
                            android:id="@+id/tv_my_elo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+20 ELO"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#4CAF50" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#E0E0E0" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thay đổi ELO"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA" />

                        <TextView
                            android:id="@+id/tv_opp_elo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-20 ELO"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#F44336" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Buttons ───────────────────────────────────────────────────── -->
        <Button
            android:id="@+id/btn_play_again"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_button_blue_fancy"
            android:text="⚔️ ĐẤU LẠI"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btn_back_home"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pvp_setting_card"
            android:text="🏠 VỀ TRANG CHỦ"
            android:textColor="#555555"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>