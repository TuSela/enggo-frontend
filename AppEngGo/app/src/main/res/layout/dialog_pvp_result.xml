<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bg_card_light_blue">

        <TextView
            android:id="@+id/tv_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="KẾT QUẢ TRẬN ĐẤU"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tv_result_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="VICTORY"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/green_correct" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Player 1 Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_p1_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bạn"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_p1_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điểm: 100"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_p1_correct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đúng: 10/10"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_p1_elo_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+25 Elo"
                    android:textColor="@color/green_correct"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- VS Divider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="VS"
                android:textStyle="bold"
                android:textColor="@color/gray_text"/>

            <!-- Player 2 Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_p2_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đối thủ"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_p2_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điểm: 80"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_p2_correct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đúng: 8/10"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_p2_elo_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-20 Elo"
                    android:textColor="@color/red_wrong"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_confirm_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="XÁC NHẬN"
            android:backgroundTint="@color/blue_primary"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
